@model WebApplication1.Models.Visitor

<h2>Visitor Pass Details</h2>

<div class="card col-md-6 mt-3">
    <div class="card-body">
        <h4 class="card-title">Pass #: @Model.PassNumber</h4>
        <hr />
        <p><strong>Name:</strong> @Model.FirstName @Model.LastName</p>
        <p><strong>Company:</strong> @Model.Company</p>
        <p><strong>Contact #:</strong> @Model.ContactNumber</p>
        <p><strong>Visiting:</strong> @Model.PersonToVisit (@Model.Department Dept.)</p>
        <p><strong>Purpose:</strong> @Model.Purpose</p>
        <p><strong>ID Presented:</strong> @Model.ValidIdPresented</p>
        <p><strong>Entry Time:</strong> @Model.EntryDateTime.ToString("f")</p>
        <p><strong>Exit Time:</strong> @(Model.ExitDateTime.HasValue? Model.ExitDateTime.Value.ToString("f") : "Still Inside")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Notes:</strong> @Model.Notes</p>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-primary">Back to Monitoring List</a>
</div>