@model IEnumerable<WebApplication1.Models.Visitor>

<div class="d-flex justify-content-between mb-3">
    <h2>Visitor Monitoring List</h2>
    <a asp-action="Create" class="btn btn-success">Register New Visitor</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Search by name, pass #, or company..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Pass Number</th>
            <th>Visitor</th>
            <th>Company</th>
            <th>Person To Visit</th>
            <th>Entry Time</th>
            <th>Exit Time</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PassNumber</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.Company</td>
                <td>@item.PersonToVisit</td>
                <td>@item.EntryDateTime.ToString("g")</td>
                <td>@(item.ExitDateTime.HasValue? item.ExitDateTime.Value.ToString("g") : "-")</td>
                <td>
                    @if (item.Status == "Inside Building")
                    {
                        <span class="badge bg-success">Inside Building</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Left Building</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white">Edit</a>
                    @if (item.Status == "Inside Building")
                    {
                        <a asp-action="Exit" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Record Exit</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>