@model WebApplication1.Models.Visitor

<h2>Edit Visitor Record</h2>

<form asp-action="Edit" method="post" class="col-md-6 mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PassNumber" />
    <input type="hidden" asp-for="EntryDateTime" />
    <input type="hidden" asp-for="ExitDateTime" />
    <input type="hidden" asp-for="Status" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Company" class="form-label"></label>
        <input asp-for="Company" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ContactNumber" class="form-label"></label>
        <input asp-for="ContactNumber" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PersonToVisit" class="form-label"></label>
        <input asp-for="PersonToVisit" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Department" class="form-label"></label>
        <input asp-for="Department" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Purpose" class="form-label"></label>
        <input asp-for="Purpose" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ValidIdPresented" class="form-label"></label>
        <input asp-for="ValidIdPresented" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-warning text-white">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>